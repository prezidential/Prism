{
  "name": "prism",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build packages/identograph/tsconfig.json packages/api/tsconfig.json",
    "migrate": "npm run migrate --workspace=packages/identograph",
    "seed": "npm run seed --workspace=packages/identograph",
    "dev:api": "npm run dev --workspace=packages/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
