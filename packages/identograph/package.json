{
  "name": "@prism/identograph",
  "version": "0.1.0",
  "private": true,
  "description": "ArcadeDB schema, migrations, and seed data for the Identograph",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrations/runner.ts",
    "seed": "tsx src/seed/index.ts",
    "db:init": "tsx src/migrations/runner.ts",
    "db:seed": "tsx src/seed/phase1-demo.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
