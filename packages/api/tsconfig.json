{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // index.ts imports the sibling @prism/risk-engine package by relative source
  // path (the monorepo never builds package dist). That foreign source falls
  // outside this package's rootDir, so the entrypoint is typechecked by the
  // repo-root tsconfig instead, which has no rootDir.
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/index.ts"]
}
