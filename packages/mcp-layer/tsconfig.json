{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // server.ts and bin.ts import the sibling @prism/identograph package by
  // relative source path (the monorepo never builds package dist). That foreign
  // source falls outside this package's rootDir, so those two boundary-crossing
  // files are typechecked by the repo-root tsconfig instead, which has no rootDir.
  "exclude": ["node_modules", "dist", "src/server.ts", "src/bin.ts"]
}
