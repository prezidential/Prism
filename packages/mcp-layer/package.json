{
  "name": "@prism/mcp-layer",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Identograph tools to Claude agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mcp:serve": "tsx --env-file=../../.env src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  }
}
